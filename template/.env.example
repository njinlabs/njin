# Server
PORT=3000

# Database
DB_PATH=rocksdb://data
DB_NAMESPACE=general
DB_DATABASE=general

# Remote SurrealDB auth — only needed if DB_PATH points at ws://, wss://, http://, or https://
# (root/system auth via DB_USERNAME + DB_PASSWORD, or a bearer token via DB_TOKEN)
# DB_TOKEN=
# DB_USERNAME=
# DB_PASSWORD=

# File storage — only needed if config.ts passes it explicitly, e.g.
# adapters: { file: bunFilesystemAdapter({ dir: process.env.FILE_DIR }) }
# FILE_DIR=./uploads

# S3 storage (only needed if config.ts wires up the S3 adapter instead of the default filesystem one)
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Image optimization — comma-separated external hosts allowed for GET /img besides same-origin/localhost
IMG_HOSTS=
